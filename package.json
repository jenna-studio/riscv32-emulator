{
    "name": "rv32emulator-ide",
    "version": "1.0.0",
    "description": "RISC-V 32-bit Emulator IDE with Monaco Editor and xterm.js",
    "author": "Your Name",
    "private": true,
    "main": "main.js",
    "type": "module",
    "scripts": {
        "start": "electron .",
        "build-emu": "make",
        "dev": "electron . --enable-logging",
        "build:mac": "make release-mac && electron-builder --mac",
        "build:win": "make release-win && electron-builder --win",
        "build:linux": "make release-linux && electron-builder --linux",
        "postinstall": "electron-builder install-app-deps"
    },
    "build": {
        "appId": "com.kmu.rv32emulator-ide",
        "productName": "RISC-V Emulator IDE",
        "directories": {
            "output": "dist"
        },
        "files": [
            "**/*",
            "!dist/**/*",
            "!node_modules/**/*",
            "!**/*.bak*",
            "!**/*.log",
            "!EMULATOR_AUDIT.md",
            "node_modules/monaco-editor/min/**/*",
            "node_modules/monaco-editor/package.json",
            "node_modules/@fortawesome/fontawesome-free/css/**/*",
            "node_modules/@fortawesome/fontawesome-free/webfonts/**/*",
            "node_modules/@fortawesome/fontawesome-free/package.json"
        ],
        "asarUnpack": [
            "obj/**/*"
        ],
        "mac": {
            "category": "public.app-category.developer-tools",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "universal"
                    ]
                }
            ],
            "icon": "icon.icns",
            "identity": null
        },
        "win": {
            "target": [
                {
                    "target": "zip",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "icon.ico"
        },
        "linux": {
            "target": [
                {
                    "target": "tar.gz",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "category": "Development"
        },
        "afterPack": "scripts/adhoc-sign.cjs"
    },
    "devDependencies": {
        "electron": "^32.0.0",
        "electron-builder": "^25.1.8"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.3.1",
        "monaco-editor": "^0.50.0"
    }
}
